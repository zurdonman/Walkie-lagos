# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.

# Dominio público con certificado automático (debe apuntar al local).
DOMAIN=walkie.turestaurante.com

# PIN que pedirá la app; cámbialo por uno propio.
PIN=cambia-este-pin

# Personalización (opcional)
APP_NAME=Walkie Lagos
TAGLINE=Radio interna del restaurante

# Límites de voz, en segundos (opcional)
MAX_TALK_SECONDS=45
MAX_ALERT_SECONDS=25
ALERTS_ENABLED=true

# Canales en JSON (opcional; si se deja vacío se usa config.json)
# ROOMS=[{"id":"cocina","name":"Cocina","emoji":"🍳"},{"id":"sala","name":"Sala","emoji":"🍽️"}]
