# Caddy delante de Walkie Lagos: HTTPS automático con Let's Encrypt.
# DOMAIN llega desde docker-compose (.env).
{$DOMAIN} {
	encode zstd gzip

	# El micrófono necesita HTTPS y los WebSocket necesitan upgrade limpio.
	reverse_proxy walkie:3000 {
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# Cámara y geolocalización no se usan; solo micrófono.
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	log {
		output stderr
		format console
	}
}
